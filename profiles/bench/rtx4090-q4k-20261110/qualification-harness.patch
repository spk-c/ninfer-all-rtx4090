diff --git a/tests/ops/linear/qualification_q4k.h b/tests/ops/linear/qualification_q4k.h
new file mode 100644
--- /dev/null
+++ b/tests/ops/linear/qualification_q4k.h
@@ -0,0 +1,21 @@
+#pragma once
+#include <cmath>
+#include <cstdint>
+
+// Stored GGML Q4_K blocks: binary16 factors, eight six-bit scale/min pairs,
+// and adjacent 32-value low/high nibble groups. Independent of GPU decoders.
+inline float qualification_half(const std::uint8_t* p) {
+    const unsigned h = unsigned(p[0]) | (unsigned(p[1]) << 8);
+    const int e = (h >> 10) & 31;
+    const double v = e ? std::ldexp(1024.0 + (h & 1023), e - 25)
+                       : std::ldexp(double(h & 1023), -24);
+    return float(h & 32768 ? -v : v);
+}
+inline float qualification_q4k(const std::uint8_t* b, int j) {
+    const int g = j / 32;
+    const auto* s = b + 4;
+    const int scale = g < 4 ? s[g] & 63 : (s[g + 4] & 15) | ((s[g - 4] >> 6) << 4);
+    const int minimum = g < 4 ? s[g + 4] & 63 : (s[g + 4] >> 4) | ((s[g] >> 6) << 4);
+    const int q = (b[16 + (g / 2) * 32 + j % 32] >> (4 * (g % 2))) & 15;
+    return (qualification_half(b) * scale) * q - qualification_half(b + 2) * minimum;
+}
